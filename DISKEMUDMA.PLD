Name     DISKEmuDMA ;
PartNo   01 ;
Date     15.05.2026 ;
Revision 01 ;
Designer cbscpe ;
Company  PRIVAT ;
Assembly None ;
Location ATHOME ;
Device   f1504isptqfp44 ;

PROPERTY ATMEL {Cascade_logic ON};
PROPERTY ATMEL {Preassign KEEP};
PROPERTY ATMEL {open_collector=BDMR, BDOUT, BDIN, BSYNC, BRPLY, BWTBT};

