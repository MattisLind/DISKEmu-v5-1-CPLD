/*
	Universal Disk Emulator for Q-BUS
	---------------------------------
	
	The universal disk emulator for the Q-BUS is a project that has been started
	after the successfull proof of concept of the MSCP Emulator. This new Q-BUS
	card will be able to emulate either a RLV12 or an MSCP disk controller with
	disks attached to it. 
	
	Already the RLV12 Emulator V2 with only through hole components required
	two CPLDs as there were not enough pins and resources available in a single
	ATF1508 in the PLCC-84 package. 

	PLCC packages have been discontinued and so we are going to use TQFP packages.
	As with the Q-BUS RLV12 emulator we split the function into two CPLDs, one
	larger ATF1508 and one smaller ATF1504. However we will no longer seperate the
	receive and the transmit BDAL path. Instead we export the DMA state machine
	into the smaller CPLD and keep the rest in the larger CPLD. The TQFP-100 
	package provides enough pins and it also simplifies the layout.	

	.\cupl.bat Z:\DISKEmu-v5-0\QBUSEMUMAIN.PLD

	C:\WinCUPL\WinCupl\Fitters\fit1508 Z:\DISKEmu-v5-0\QBUSEMUMAIN.tt2 -CUPL -dev P1508T100 -JTAG ON
	
	2026-05-03	Initial Version
	
	2026-05-20	Synchronize CPLD pin-out with KiCAD design
			Conditional logic if ROMADDR is defined
			Rename SAR to BSY, add BSY to data output logic to return zero
			in case BSY is set.
	2026-05-31	TDOUT must be delayed and then used as output enable
			RIAKI must be delayed to generate RPLY else it will assert
			an IACK immediately
			Logic for CRDY and SAR must be changed, we need to make sure
			that SA read returns zero when CRDY is de-asserted so we
			add a data enable signal ENA which replaces the logic of BSY
	2026-07-30	Implement ROMEN bit
	
			
 */
/************************** Q-BUS Interface *******************************************/
PIN        46 =  RDAL0;
PIN        44 =  RDAL1;
PIN        98 =  RDAL2;
PIN        25 =  RDAL3;
PIN         1 =  RDAL4;
PIN        32 =  RDAL5;
PIN        31 =  RDAL6;
PIN        30 =  RDAL7;
PIN       100 =  RDAL8;
PIN        99 =  RDAL9;
PIN         2 =  RDAL10;
PIN        24 =  RDAL11;
PIN        13 =  RDAL12;
PIN         5 =  RDAL13;
PIN         6 =  RDAL14;
PIN         7 =  RDAL15;

PIN        47 =  TDAL0;
PIN        45 =  TDAL1;
PIN        36 =  TDAL2;
PIN        35 =  TDAL3;
PIN        33 =  TDAL4;
PIN        16 =  TDAL5;
PIN        17 =  TDAL6;
PIN        27 =  TDAL7;
PIN         8 =  TDAL8;
PIN        20 =  TDAL9;
PIN        10 =  TDAL10;
PIN        21 =  TDAL11;
PIN        22 =  TDAL12;
PIN        23 =  TDAL13;
PIN        28 =  TDAL14;
PIN        29 =  TDAL15;
PIN        60 =  TDAL16;
PIN        58 =  TDAL17;
PIN        42 =  TDAL18;
PIN        41 =  TDAL19;
PIN        40 =  TDAL20;
PIN        37 =  TDAL21;

PIN        54 =  RSYNC;
PIN        48 =  RBS7;
PIN        55 =  RDIN;
PIN        57 =  RDOUT;
PIN        53 =  RWTBT;
PIN        89 =  RINIT;
PIN        49 =  RIAKI;

PIN        56 =  TRPLY;
PIN        50 =  TIAKO;
PIN        52 =  TIRQ;

/************************** AVR Interface *********************************************/
PIN        90 =  CLK;	/* Master Clock							*/
PIN        88 =  RD;	/* Read CPLD device register					*/
PIN        87 =  WR;	/* Write CPLD device register					*/
PIN        97 =  AD0;	/* Register Data						*/
PIN        96 =  AD1;
PIN        94 =  AD2;
PIN        93 =  AD3;
PIN        92 =  AD4;
PIN        81 =  AD5;
PIN        80 =  AD6;
PIN        79 =  AD7;
PIN        78 =  RS0;
PIN        77 =  RS1;
PIN        76 =  RS2;

PIN        75 =  INTI;	/* IACK Cycle Interrupt						*/
PIN        72 = !INTQ;	/* Q-BUS Cycle Interrupt					*/
PIN        71 =  ACK;	/* Acknowledge interrupt					*/
PIN        70 =  CRDY;	/* Controller ready, if de-asserted Q-Bus reads return zero	*/
PIN        83 =  MSCP;	/* asserted: MSCP Emulation, de-asserted: RVL12 Emulation	*/
PIN        69 =  IRQ;	/* Request interrupt						*/

/************************** CPLD-to-CPLD  *********************************************/
PIN        68 =  DMARD;
PIN        67 =  LD;	/* DMA Load Q-BUS data to DMA data register			*/
PIN        65 =  TADDR;	/* DMA Address Active						*/
PIN        19 =  TSACK;	/* DMA Active							*/
PIN        61 =  TDOUT;	/* DMA Data Out							*/

PINNODE       = [DD15..0]     ; /* DMA Data Register A                             */
PINNODE       = [DQ15..0]     ; /* QBUS Data Register B                            */
PINNODE       = [A21..1]      ; /* DMA Address                                     */
PINNODE       =  I7;
PINNODE       =  I14;
PINNODE       =  CSR;
PINNODE       =  ROM;
PINNODE       =  ENA;
PINNODE       =  DACK;
PINNODE       =  CWTBT;
PINNODE       = [C6..1]:
PINNODE       =  CWTBT;
PINNODE       =  TDOUT1;
PINNODE       =  RIAKI1;
PINNODE       =  RIAKI2;
PINNODE       =  ROMEN;

FIELD  RS     = [RS2..0];

/************************** Definitions   *********************************************/
$DEFINE MSCPADDR  'o'172150..172153
$DEFINE RLV12ADDR 'o'174400..174417
$DEFINE ROMADDR   'o'173000..173177

/************************** Equations     *********************************************/
[C6..1].d     = [RDAL6..1];
[C6..1].ck    =  RSYNC;

CWTBT.d       =  RWTBT;
CWTBT.ck      =  RSYNC;

INTQ.d        =  RBS7 & [RDAL12..1]:[RLV12ADDR] & !MSCP  &  CRDY
              #  RBS7 & [RDAL12..1]:[MSCPADDR]  &  MSCP  &  RWTBT
              #  RBS7 & [RDAL12..1]:[MSCPADDR]  &  MSCP  & !RWTBT & !RDAL1   
              #  RBS7 & [RDAL12..1]:[MSCPADDR]  &  MSCP  & !RWTBT &  RDAL1 &  CRDY;

$IFDEF ROMADDR
APPEND
INTQ.d        =  RBS7 & [RDAL12..1]:[ROMADDR]   &  ROMEN;
$ENDIF

INTQ.ck       =  RSYNC;
INTQ.ar       =  ACK;
        
ENA.d         =  RBS7 & [RDAL12..1]:[RLV12ADDR] & !MSCP  & !RWTBT &  CRDY
              #  RBS7 & [RDAL12..1]:[MSCPADDR]  &  MSCP  & !RWTBT          & !RDAL1   
              #  RBS7 & [RDAL12..1]:[MSCPADDR]  &  MSCP  & !RWTBT &  CRDY  &  RDAL1;

$IFDEF ROMADDR
APPEND
ENA.d         =  RBS7 & [RDAL12..1]:[ROMADDR]   &  ROMEN &  !RWTBT;
$ENDIF

ENA.ck        =  RSYNC;
        
CSR.d         =  RBS7 & [RDAL12..1]:[RLV12ADDR] & !MSCP  
              #  RBS7 & [RDAL12..1]:[MSCPADDR]  &  MSCP;

$IFDEF ROMADDR
APPEND
CSR.d         =  RBS7 & [RDAL12..1]:[ROMADDR]   &  ROMEN;
$ENDIF

CSR.ck        =  RSYNC;

TRPLY         =  CSR &  RSYNC & !INTQ &  RDIN
              #  CSR &  RSYNC & !INTQ &  RDOUT;

$IFDEF ROMADDR
ROM.d         = [RDAL12..1]:[ROMADDR];
ROM.ck        =  RSYNC;
$ENDIF

/*
	Interrupt logic

	       -------------------
TIRQ	      /                   \
	------                     --------------------------------------------
	      | >150ns  |
	                 -------------------------
RDIN	                /                         \
	----------------                           ----------------------------
	                |>100ns|
	                        -------------------
RIAKI	                       /                   \
	-----------------------                     ---------------------------

	                              ------------------
TRPLY	                             /                  \
	-----------------------------                    ---------------------
	                             | <125ns  |        |>100ns    |
	--------------------------------------- ------------------- ----------
TDAL	                                       X     vector        X
	--------------------------------------- ------------------- ----------

 */
RIAKI1.d        =  RIAKI;
RIAKI2.d        =  RIAKI1;

RIAKI1.ck       =  CLK;
RIAKI2.ck       =  CLK;
 
DACK.d		=  IRQ;
DACK.ck		=  RDIN;
DACK.ar		=  RINIT;

TIAKO		=  RIAKI    & !DACK;
TIRQ		=  IRQ;

INTI.d		= !DACK;
INTI.ck		=  RIAKI;
INTI.ap		=  ACK;

APPEND
TRPLY		=  RIAKI2 & RDIN & DACK & INTI;

/*
	Q-Bus Data Register
 */
[DQ7..0].d	=  [AD7..0].io;
[DQ15..8].d	=  [AD7..0].io;
[DQ15..0].ck	=  WR;
[DQ7..0].ce	=  RS:['d'0];
[DQ15..8].ce	=  RS:['d'1];

/*
	DMA Data Register
 */
[DD7..0].d	=  [AD7..0].io;
[DD15..8].d	=  [AD7..0].io;
[DD15..0].ck	=  WR;
[DD7..0].ce	=  RS:['d'2];
[DD15..8].ce	=  RS:['d'3];

[DD15..0].ar	=  LD & ![RDAL15..0];
[DD15..0].ap	=  LD &  [RDAL15..0];

/*
	ROM Enable
 */
ROMEN.d         =  AD0.io;
ROMEN.ce        =  RS:['d'5];
ROMEN.ck        =  WR;

/*
	DMA Address Register and DMA direction bit
 */
DMARD.ar	=  WR  &  RS:['d'4] & !AD0.io;
DMARD.ap	=  WR  &  RS:['d'4] &  AD0.io;
DMARD.ck	= 'b'0;
DMARD.d		= 'b'0;

[A7..1].ar	=  WR  &  RS:['d'4] & ![AD7..1].io;
[A7..1].ap	=  WR  &  RS:['d'4] &  [AD7..1].io;

[A15..8].ar	=  WR  &  RS:['d'5] & ![AD7..0].io;
[A15..8].ap	=  WR  &  RS:['d'5] &  [AD7..0].io;

[A21..16].ar	=  WR  &  RS:['d'7] & ![AD5..0].io;
[A21..16].ap	=  WR  &  RS:['d'7] &  [AD5..0].io;

/*
	MCU data interface to read the Q-BUS data during DATO, reading the word
	received via DMA or address and direction of the device register or ROM
	address accessed by the host. Note that neither the RLV12 nor the MSCP
	controller support byte access.
 */
[AD7..0]	=  RS:['d'0] &  [RDAL7..0] 
		#  RS:['d'1] &  [RDAL15..8]
		#  RS:['d'2] &  [DD7..0]
		#  RS:['d'3] &  [DD15..8]
		#  RS:['d'4] &  ['b'0, C6, C5, C4, C3, C2, C1, CWTBT];

$IFDEF ROMADDR
APPEND
AD7             =  RS:['d'4] &  ROM;
$ENDIF

[AD7..0].oe	=  RD;

/*
	Synchronous counter for DMA address which is updated after every DMA 
	cycle. The address is incremented whenever the DMA cycle has finished.
 */	
[A21..1].ck	= !TSACK;

A1.t		= 'b'1;
A2.t		= A1;
A3.t		= A1  & A2;
A4.t		= A1  & A2  &  A3;
A5.t		= A1  & A2  &  A3  & A4;
A6.t		= A1  & A2  &  A3  & A4  & A5;
A7.t		= A1  & A2  &  A3  & A4  & A5  & A6;
I7		= A1  & A2  &  A3  & A4  & A5  & A6  & A7;

A8.t		= I7;
A9.t		= I7  & A8;
A10.t		= I7  & A8  &  A9;
A11.t		= I7  & A8  &  A9  & A10;
A12.t		= I7  & A8  &  A9  & A10 & A11;
A13.t		= I7  & A8  &  A9  & A10 & A11 & A12;
A14.t		= I7  & A8  &  A9  & A10 & A11 & A12 & A13;
I14		= I7  & A8  &  A9  & A10 & A11 & A12 & A13 & A14;

A15.t		= I14;
A16.t		= I14 & A15;
A17.t		= I14 & A15 & A16;
A18.t		= I14 & A15 & A16 & A17;
A19.t		= I14 & A15 & A16 & A17 & A18;
A20.t		= I14 & A15 & A16 & A17 & A18 & A19;
A21.t		= I14 & A15 & A16 & A17 & A18 & A19 & A20;

/*
	Q-Bus Output Select and Output Enable
 */

TDOUT1.d        =  TDOUT;
TDOUT1.ck       =  CLK;

[TDAL15..0]	= !RIAKI  & !TSACK  &  CSR    &  ENA  &  RDIN &  [DQ15..0]
		# !RIAKI  &  TSACK  &  TADDR                  &  [A15..1, 'b'0]
		# !RIAKI  &  TSACK  &  TDOUT1                 &  [DD15..0];

APPEND
[TDAL8..2]	=  RIAKI  &  DACK                             &  [DQ8..2];		

[TDAL21..16]	= !RIAKI  &  TSACK  &  TADDR                  &  [A21..16];
