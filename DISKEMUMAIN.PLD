Name     DISKEmuDMA ;
PartNo   01 ;
Date     03.05.2026 ;
Revision 01 ;
Designer cbscpe ;
Company  PRIVAT ;
Assembly None ;
Location ATHOME ;
Device   f1508isptqfp100 ;
PROPERTY ATMEL {SOFT_BUFFER=I14, I7};

PROPERTY ATMEL {Cascade_logic ON};
PROPERTY ATMEL {Preassign KEEP};
PROPERTY ATMEL {SOFT_BUFFER=I14, I7, BUSEN};
PROPERTY ATMEL {open_collector=BRPLY, BIRQ, BSACK};

